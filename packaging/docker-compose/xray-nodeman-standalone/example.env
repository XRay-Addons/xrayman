# ╔══════════════════════════════════════════════════╗
# ║ container includes only xray-nodeman,            ║
# ║ postgress db is requried,                        ║
# ║ tools to visualize metrics                       ║
# ║ (like prometheus, grafana, vmetrics) is optional ║
# ║ vmetrics and grafana to visualize metrics        ║
# ╚══════════════════════════════════════════════════╝

# Nodeman server endpoint tcp port, like 8080
XRAY_NODEMAN_PORT=

# Nodeman metrics endpoint tcp port, like 9090
XRAY_NODEMAN_METRICS_PORT=

# Postgress connection string deployed somewhere
# (don't forget to escape special characters in password if any)
XRAY_NODEMAN_DB=

# JWT secret for admin page auth
XRAY_NODEMAN_JWT=

# Admin page password
XRAY_NODEMAN_ADM_PASS=

# [optional] Public-facing base URL of nodeman API, as seen by clients
# (e.g. behind a reverse proxy / TLS termination).
# Used when the server needs to build a full external
# URL to itself (e.g. https://api.example.com/api),
# as opposed to --endpoint, which is the internal
# address the process actually listens on. 
# Should be short like /api or full https://api.example.com/apipath
# XRAY_NODEMAN_API_SERVICE_URL=

# [optional] Public-facing base URL of user page, as seen by clients
# (e.g. behind a reverse proxy / TLS termination).
# Used when the server needs to build a full external
# URL to itself (e.g. https://u.example.com/user),
# Should be short like /u or full https://u.example.com/user
# XRAY_NODEMAN_USER_SPA_URL=

# [optional] Public-facing base URL of admin page, as seen by clients
# (e.g. behind a reverse proxy / TLS termination).
# Used when the server needs to build a full external
# URL to itself (e.g. https://a.example.com/adm),
# Should be short like /adm or full https://adm.example.com/admin
# XRAY_NODEMAN_ADMIN_SPA_URL=

# [optional] Nodes state check and sync interval, every N s
# XRAY_NODEMAN_STATE_SYNC_INTERVAL

# [optional] Nodes statistics refresh interval, every N s
# XRAY_NODEMAN_STATS_SYNC_INTERVAL

# [optional] Nodes api calls timeout s
# XRAY_NODEMAN_NODE_CALL_TIMEOUT

# [optional] Storage (database) calls timeout s
# XRAY_NODEMAN_STORAGE_CALL_TIMEOUT

# [optional] Zap log level like 'info', 'warning'
# XRAY_NODE_LOG_LEVEL=