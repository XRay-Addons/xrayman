# PostgreSQL connection string
XRAY_NODEMAN_DB=postgresql://user:password@127.0.0.1:5432/dbname

# Secret used to sign JWT tokens
XRAY_NODEMAN_ADM_PASS=change-me

# HTTP server endpoint
XRAY_NODEMAN_ENDPOINT=:8080

# Optional admin password
# Leave empty to keep the previous password.
XRAY_NODEMAN_ADM_PASS=

# Public API URL as seen by browsers
XRAY_NODEMAN_API_SERVICE_URL=

# Public User SPA URL as seen by browsers
XRAY_NODEMAN_USER_SPA_URL=

# Public Admin SPA URL as seen by browsers
XRAY_NODEMAN_ADMIN_SPA_URL=

# State synchronization interval, seconds
XRAY_NODEMAN_STATE_SYNC_INTERVAL=5

# Statistics synchronization interval, seconds
XRAY_NODEMAN_STATS_SYNC_INTERVAL=60

# Node call timeout, seconds
XRAY_NODEMAN_NODE_CALL_TIMEOUT=5

# Storage call timeout, seconds
XRAY_NODEMAN_STORAGE_CALL_TIMEOUT=5

# Optional Prometheus metrics endpoint
XRAY_NODEMAN_METRICS_ENDPOINT=

# Zap log level
XRAY_NODEMAN_LOG_LEVEL=info
