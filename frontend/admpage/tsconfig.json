{
  "include": ["src"],
  "exclude": ["src/services/api/generated/**"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@xrayman/shared/*": ["../shared/src/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": false
  },
  "astro": {
    "check": {
      "strict": true
    }
  }
}
