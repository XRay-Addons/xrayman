---
import type { CardItem } from "./CardBase";

interface Props {
  items: CardItem[];
}

const { items } = Astro.props;
---

{}
<!---
<dynamic-cfg-card>
  <BaseCard>
    <Title class="col-6 mb-2">
      <I18NText data-i18n=`${i18n}.title` />
    </Title>

    <form data-part="form" id={hiddenFormID}>
      <FormField
        i18n=`${i18nFields}.fieldA`
        field="fieldA"
        form={hiddenFormID}
        dtype="string"
        data-part="form-input"
      />
      <FormField
        i18n=`${i18nFields}.fieldB`
        field="fieldB"
        form={hiddenFormID}
        dtype="int"
        data-part="form-input"
        min="1"
      />
      <FormField
        i18n=`${i18nFields}.fieldC`
        field="fieldC"
        form={hiddenFormID}
        dtype="number"
        data-part="form-input"
      />

      <ArrayFormField
        i18n=`${i18nFields}.fieldArr`
        field="fieldArr"
        form={hiddenFormID}
        items={parts}
        data-part="form-input"
      />
    </form>

    <Button data-part="submit-btn" data-i18n=`${i18n}.submit` form={hiddenFormID} type="submit" />
    <Button data-part="refresh-btn" data-i18n=`${i18n}.refresh` />
  </BaseCard>
</dynamic-cfg-card>

<script>
  import { pt, pts } from "@xrayman/shared/runtime/dom/pts";
  import { FormFieldElement } from "./FormField";

  class DynamicCfgCard extends HTMLElement {
    private formEl!: HTMLFormElement;
    private formItems: FormFieldElement[] = [];
    private data: Record<string, any> = {
      fieldA: "sample text",
      fieldB: 2,
      fieldC: 14.5,
      duration: 1,
      fieldArr: [],
    };

    async connectedCallback() {
      this.formEl = pt<HTMLFormElement>(this, "form");
      this.formItems = pts<FormFieldElement>(this, "form-input");

      // submit event
      this.formEl.addEventListener("submit", async (e: Event) => {
        e.preventDefault();
        this.updateData();
        console.log(this.data);
      });

      // refresh event
      const refreshBtn = pt<HTMLButtonElement>(this, "refresh-btn");
      refreshBtn.addEventListener("click", async (e: Event) => {
        e.preventDefault();
        this.refreshData();
      });

      this.refreshData();
    }

    protected render() {}

    updateData() {
      this.formItems.forEach((el) => {
        el.updateData(this.data);
      });
    }

    refreshData() {
      this.formItems.forEach((el) => {
        console.log(el);
        el.refreshData(this.data);
      });
    }
  }

  customElements.define("dynamic-cfg-card", DynamicCfgCard);
</script>

-->
