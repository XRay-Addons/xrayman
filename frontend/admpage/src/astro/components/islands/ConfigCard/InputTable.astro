---
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import Surface from "@xrayman/shared/astro/primitives/Surface.astro";
import InputTags from "@xrayman/shared/astro/primitives/InputTags.astro";
import DataInput from "./DataInput.astro";
import type { Column } from "./InputTable";

interface Props {
  form?: string;
  i18n: string;
  columns: Column[];
}

const { form, i18n, columns, ...rest } = Astro.props;
---

<input-table form={form} {...rest}>
  <Info>
    <I18NText data-i18n={i18n} />
  </Info>

  <div>
    <table>
      <thead>
        <tr>
          {
            columns.map((column) => (
              <th {...column.attrs}>
                <Info>
                  <I18NText data-i18n=`${i18n}.${column.field}` />
                </Info>
              </th>
            ))
          }
        </tr>
      </thead>

      <tbody data-part="tbody"></tbody>
    </table>
  </div>

  <Button data-part="add-row-btn" data-i18n=`${i18n}.add-btn`></Button>

  <template data-part="row-template">
    <tr>
      {
        columns.map((column) => (
          <td data-part="cell-container" data-field={column.field}>
            <DataInput data-part="cell" form={form} dtype={column.dtype} {...column.attrs} />          
          </td>
        ))
      }
      <td class="td-btn">
        <Button data-part="remove-row-btn" content-class="btn-ellipsed">
          <I18NText data-i18n=`${i18n}.remove-btn` />
        </Button>
      </td>
    </tr>
  </template>
</input-table>

<style>
  table {
    width: 100%;
    table-layout: fixed;
  }
  .btn-ellipsed {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { InputTableElement } from "./InputTable";
  import { DataInputElement } from "./DataInput";
  import { pt, pts } from "@xrayman/shared/runtime/dom/pts";

  class InputTable extends HTMLElement implements InputTableElement {
    private tbody!: HTMLElement;
    private rowTemplate!: HTMLTemplateElement;

    connectedCallback() {
      this.tbody = pt<HTMLElement>(this, "tbody");
      this.rowTemplate = pt<HTMLTemplateElement>(this, "row-template");

      const addBtn = pt<HTMLButtonElement>(this, "add-row-btn");
      addBtn.onclick = () => {
        this.addRow({});
      };
      this.value = [];
    }

    disconnectedCallback() {}

    set value(data: Record<string, any>[]) {
      data.push({ nfieldA: "a", nfieldB: 3 });
      data.push({ nfieldA: "b", nfieldB: 4 });

      this.tbody.replaceChildren();

      data.forEach((rowData) => {
        this.addRow(rowData);
      });
    }

    get value(): Record<string, any>[] {
      const data: Record<string, any>[] = [];
      const rows = Array.from(this.tbody.children);
      rows.forEach((row) => {
        data.push(this.getRowValue(row));
      });
      return data;
    }

    addRow(data: Record<string, any>): void {
      const rowFragment = document.importNode(this.rowTemplate.content, true);
      const rowEl = rowFragment.firstElementChild as HTMLElement;
      this.tbody.appendChild(rowFragment);

      const cells = pts<HTMLElement>(rowEl, "cell-container");
      cells.forEach((cell) => {
        const field = cell.dataset["field"]!;
        const input = pt<DataInputElement>(cell, "cell");
        input.value = data[field];
      });

      const removeBtn = pt<HTMLButtonElement>(rowEl, "remove-row-btn");
      removeBtn.onclick = () => {
        rowEl.remove();
      };
    }

    getRowValue(rowEl: Element): Record<string, any> {
      var data: Record<string, any> = {};
      const cells = pts<HTMLElement>(rowEl, "cell-container");
      cells.forEach((cell) => {
        const field = cell.dataset["field"]!;
        const input = pt<DataInputElement>(cell, "cell");
        data[field] = input.value;
      });
      return data;
    }
  }

  customElements.define("input-table", InputTable);
</script>
