---
import Surface from "@xrayman/shared/astro/primitives/Surface.astro";
import { type WithPrefix, ExtractPrefixed } from "@xrayman/shared/astro/props/props";
import type { ComponentProps } from "astro/types";

interface Props extends ComponentProps<typeof Surface>, WithPrefix<"input", "input:"> {}

const surfaceProps = { ...Astro.props };
const inputProps = ExtractPrefixed(surfaceProps, "input:");
---

<Surface depth="var(--input-depth)" color="var(--input-color)" {...surfaceProps}>
  <input class="ui-reset-input w-100 text text-md crt p-2" {...inputProps} />
</Surface>
