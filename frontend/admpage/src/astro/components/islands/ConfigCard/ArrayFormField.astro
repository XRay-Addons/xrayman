---
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import type { ArrayItemProp } from "./ArrayFormField";
import DataInput from "./DataInput.astro";

interface Props {
  i18n: string;
  field: string;
  form: string;

  items: ArrayItemProp[];
}

const { i18n, field, form, items, ...rest } = Astro.props;
---

<array-field field={field} form={form} {...rest}>
  <Info>
    <I18NText data-i18n={i18n} />
  </Info>

  <table>
    <tr>
      {
        items.map((item) => (
          <th>
            <Info>
              <I18NText data-i18n={item.i18n} />
            </Info>
          </th>
        ))
      }
    </tr>

    <tbody data-part="items-container"></tbody>

    <template data-part="item-template">
      <tr>
        {
          items.map((item) => (
            <td data-part="item-field-container" data-field={item.field}>
              <DataInput data-part="item-field" form={form} dtype={item.dtype} {...item.attrs} />
            </td>
          ))
        }
      </tr>
    </template>
  </table>
  <Button data-i18n=`${i18n}.add-btn`>+</Button>
</array-field>

<script>
  import { DataInputElement } from "./DataInput";
  import { pt, pts } from "@xrayman/shared/runtime/dom/pts";
  import { FormFieldElement } from "./FormField";

  class ArrayField extends HTMLElement implements FormFieldElement {
    private itemsContainer!: HTMLElement;
    private itemTemplate!: HTMLTemplateElement;
    private field!: string;

    connectedCallback() {
      this.itemsContainer = pt<HTMLElement>(this, "items-container");
      this.itemTemplate = pt<HTMLTemplateElement>(this, "item-template");
      this.field = this.getAttribute("field")!;
    }

    disconnectedCallback() {}

    refreshData(data: Record<string, any>): void {
      const itemsData = data[this.field] as Record<string, any>[];
      itemsData.push({ nfieldA: "a", nfieldB: 3 });
      itemsData.push({ nfieldA: "b", nfieldB: 4 });

      this.itemsContainer.replaceChildren();

      itemsData.forEach((itemData) => {
        const fragment = document.importNode(this.itemTemplate.content, true);
        const rowEl = fragment.firstElementChild as HTMLElement;
        this.itemsContainer.appendChild(fragment);

        const cellEls = pts<HTMLElement>(rowEl, "item-field-container");
        cellEls.forEach((cellEl) => {
          const field = cellEl.dataset["field"]!;
          const input = pt<DataInputElement>(cellEl, "item-field");
          input.value = itemData[field];
        });
      });
    }

    updateData(data: Record<string, any>): void {
      const itemsData: Record<string, any>[] = [];
      const rowEls = Array.from(this.itemsContainer.children);
      rowEls.forEach((rowEl) => {
        var itemData: Record<string, any> = {};
        const cellEls = pts<HTMLElement>(rowEl, "item-field-container");
        cellEls.forEach((cellEl) => {
          const field = cellEl.dataset["field"]!;
          const input = pt<DataInputElement>(cellEl, "item-field");
          itemData[field] = input.value;
        });
        itemsData.push(itemData);
      });
      data[this.field] = itemsData;
    }
  }

  customElements.define("array-field", ArrayField);
</script>
