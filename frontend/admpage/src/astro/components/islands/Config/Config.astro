---
import Input from "./Input.astro";
import TaggedInput from "./TaggedInput/TaggedInput.astro";
import ListInput from "./ListInput/ListInput.astro";
import type { HTMLAttributes } from "astro/types";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import type { ListItemField } from "./ListInput/ListInput.astro"
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";

type FieldType = "input" | "tagged-input" | "list-input";
type InputAttrs = Omit<HTMLAttributes<"input">, "name">;

interface Field {
  name: string;
  type: FieldType;
}

export interface InputField extends Field {
  inputProps?: InputAttrs;
}

export interface ListField extends Field {
  listInputs: ListItemField[];
}

type FormProps = WithPrefix<HTMLAttributes<"form">, "form">;
type HostProps = HTMLAttributes<"div">;

interface Props extends FormProps, HostProps {
  i18n: string;
  fields: (InputField | ListField)[];
}


const { i18n, fields, ...props } = Astro.props;
const { ...formProps } = ExtractPrefixed(props, "form");
---

<config-editor {...props}>
  <form data-config-form { ...formProps}>
    {
      fields.map((field) => {
        let component;
        switch (field.type) {
          case "input": {
            const p = field as InputField;
            component = (
              <Input
                input:name={p.name}
                input:data-config-input
                input={{ ...(p.inputProps || {}) }} />
            );
            break;
          }
          case "tagged-input": {
            const p = field as InputField;
            component = (
              <TaggedInput
                data-config-tagged-input
                input:name={p.name}
                input:data-config-input
                input={{ ...(p.inputProps || {}) }}
              />
            );
            break;
          }
          case "list-input": {
            const p = field as ListField;
            component = (
              <div class="list-input">
                <ListInput
                  name={p.name}
                  data-config-list-input
                  i18n={`${i18n}.fields.${p.name}`}
                  fields={ p.listInputs }}
                />
              </div>
            );
            break;
          }
        }
        const i18nKey = field.type === "list-input"
            ? `${i18n}.fields.${field.name}.title`
            : `${i18n}.fields.${field.name}`;

        return (
          <Fragment>
            <Info>
              <I18NText data-i18n={i18nKey} />
            </Info>
            {component}
          </Fragment>
        );
      })
    }
  </form>
</config-editor>

<style>

config-editor {
  display: block;
}

.list-input {
  padding-left: 0.5rem;
  padding-right: 0.5rem;
  background-color: rgba(0, 0, 0, 0.05);
  border: 2px solid rgba(0, 0, 0, 0.25);
}
</style>

