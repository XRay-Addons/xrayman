---
import Title from "@xrayman/shared/astro/primitives/Title.astro";
import Card from "@xrayman/shared/astro/primitives/Card.astro";
import Map from "@xrayman/shared/astro/primitives/Map.astro";

import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import SuccessMsg from "@xrayman/shared/astro/primitives/SuccessMsg.astro";

import LabeledInput from "../primitives/LabeledInput.astro";
---

<dynamic-cfg-page>
  <Card>
    <Title class="col-6 mb-2">
      <I18NText data-i18n="cards.dynamic-cfg.edit-title" />
    </Title>

    <Map data-part="cfg-map" />

    <div>
      <LabeledInput data-part="subscr-title" label-i18n="cards.dynamic-cfg.subscr-title" />
      <LabeledInput data-part="user-message" label-i18n="cards.dynamic-cfg.user-message" />
      <LabeledInput data-part="user-page" label-i18n="cards.dynamic-cfg.user-page" />
      <LabeledInput data-part="tg-page" label-i18n="cards.dynamic-cfg.tg-page" />
      <LabeledInput data-part="update-interval" label-i18n="cards.dynamic-cfg.update-interval" />
    </div>

    <div class="d-flex justify-content-center">
      <Button data-part="submit-input" class="col-8">
        <I18NText data-i18n="cards.dynamic-cfg.submit-btn.info" />
      </Button>
    </div>

    <div data-part="success-result" hidden>
      <SuccessMsg class="col-8">
        <I18NText data-i18n="cards.dynamic-cfg.response.info" />
      </SuccessMsg>
    </div>
  </Card>

  <script>
    import { setDynamicConfig, getDynamicConfig } from "@/services/api/client";
    import type { DynamicConfig } from "@/services/api/generated/types.gen";

    import { notifyApiError } from "@/runtime/notifications/use-notifications";
    import type { ResettableElement } from "@xrayman/shared/astro/types/Resettable";
    import { PartedElement } from "@xrayman/shared/runtime/dom/parted-element";
    import type { LabeledInputElement } from "../types/LabeledInput";
    import type { MapElement } from "@xrayman/shared/astro/types/Map";
    import { config } from "@/config/config";

    type FieldDef = {
      part: string;
      key: keyof DynamicConfig;
      placeholders?: string[];
      in?: (v: any) => string;
      out?: (v: string) => any;
    };

    const FIELDS: FieldDef[] = [
      {
        part: "subscr-title",
        key: "SubscrTitle",
        placeholders: config.sub_headers_placeholders,
      },
      {
        part: "user-message",
        key: "UsersMessage",
        placeholders: config.sub_headers_placeholders,
      },
      {
        part: "user-page",
        key: "UserPage",
        placeholders: config.sub_headers_placeholders,
      },
      {
        part: "tg-page",
        key: "TgPage",
      },
      {
        part: "update-interval",
        key: "UpdateInterval",
        in: (v) => String(v),
        out: (v) => parseInt(v, 10) || 0,
      },
    ];

    class DynamicCfgPage extends PartedElement implements ResettableElement {
      private fields = new Map<keyof DynamicConfig, LabeledInputElement>();
      private submitEl!: HTMLButtonElement;
      private successResultEl!: HTMLElement;
      private cfgMapEl!: MapElement;

      async connectedCallback() {
        const response = await getDynamicConfig();
        if (!response.ok) {
          notifyApiError("get_dyn_cfg", response.reason);
          return;
        }

        const cfg = response.data;

        // init fields
        for (const def of FIELDS) {
          const el = this.pt<LabeledInputElement>(def.part);

          if (def.placeholders) {
            el.setPlaceholders(def.placeholders);
          }

          const value = cfg[def.key];
          el.setValue(def.in ? def.in(value) : String(value));

          this.fields.set(def.key, el);
        }

        this.cfgMapEl = this.pt<MapElement>("cfg-map");

        this.cfgMapEl.setValue([
          ["k1", "v1"],
          ["k2", "v2"],
        ]);

        this.submitEl = this.pt<HTMLButtonElement>("submit-input");
        this.successResultEl = this.pt<HTMLElement>("success-result");

        this.submitEl.onclick = async () => {
          const cfg = {} as DynamicConfig;

          for (const def of FIELDS) {
            const el = this.fields.get(def.key)!;
            const raw = el.getValue();

            (cfg as any)[def.key] = def.out ? def.out(raw) : raw;
          }

          this.successResultEl.hidden = true;

          const response = await setDynamicConfig(cfg);
          if (!response.ok) {
            notifyApiError("set_dyn_cfg", response.reason);
            return;
          }

          this.successResultEl.hidden = false;
        };
      }

      reset() {
        for (const el of this.fields.values()) {
          el.setValue("");
        }
        this.successResultEl.hidden = true;
      }
    }

    customElements.define("dynamic-cfg-page", DynamicCfgPage);
  </script>
</dynamic-cfg-page>
