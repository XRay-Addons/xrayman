---
import SettingsPage from "./SettingsPage.astro";
import ButtonDialog from "@xrayman/shared/astro/primitives/ButtonDialog/ButtonDialog.astro";
---

<ButtonDialog class="h-100 squared">
  <div slot="button" class="settings-icon"></div>

  <SettingsPage slot="page" />
</ButtonDialog>

<style lang="scss">
  @use "@xrayman/shared/styles/shades.scss" as *;

  .settings-icon {
    width: 1.5rem;
    height: 1.5rem;

    background-color: contrasted(var(--button-color));

    mask: url("/settings.svg") center / contain no-repeat;
    -webkit-mask: url("/settings.svg") center / contain no-repeat;
  }
</style>
