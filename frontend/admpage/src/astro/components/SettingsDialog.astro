---
import SettingsPage from "./SettingsPage.astro";
import ButtonDialog from "@xrayman/shared/astro/primitives/ButtonDialog/ButtonDialog.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
---

<ButtonDialog>
  <div slot="button" class="settings-button">
    <I18NText data-i18n="settings.button.text" />
  </div>
  <SettingsPage slot="page" />
</ButtonDialog>

<style>
  .settings-button {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    line-height: 1;
  }
</style>
