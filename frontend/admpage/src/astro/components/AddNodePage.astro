---
import Card from "@xrayman/shared/astro/primitives/Card.astro";
import Title from "@xrayman/shared/astro/primitives/Title.astro";
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import type { InputField, ListField } from "@xrayman/shared/astro/primitives/Config/Config.astro";
import Config from "@xrayman/shared/astro/primitives/Config/Config.astro";
import ActiveSlot from "@xrayman/shared/astro/primitives/ActiveSlot/ActiveSlot.astro";

const i18n = "add-node";
const i18nReq = "add-node.request";

const fields: (InputField | ListField)[] = [
  {
    name: "endpoint",
    type: "input",
    placeholder: true,
    inputProps: { required: true },
  },
  {
    name: "accesskey",
    type: "input",
    placeholder: true,
    inputProps: { required: true },
  },
];
---

<add-node-page class="fluid-md">
  <Card>
    <Title class="mb-2">
      <I18NText data-i18n=`${i18n}.title` />
    </Title>

    <Config i18n={i18nReq} fields={fields} class="mb-2" data-config form:data-config-form />

    <div class="d-flex justify-content-center">
      <Button btn:data-submit-btn class="col-8" btn:type="submit">
        <ActiveSlot data-submit-btn-content>
          <I18NText data-i18n=`${i18n}.submit-btn.info` />
        </ActiveSlot>
      </Button>
    </div>
  </Card>
</add-node-page>

<script>
  import { newNode } from "@/services/api/client";
  import { notifyApiError } from "@/runtime/notifications/use-notifications";
  import { reloadNodes } from "@/actions/nodes";
  import type { Resettable } from "@xrayman/shared/astro/primitives/ButtonDialog/ButtonDialog";
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { ConfigEditorElement } from "@xrayman/shared/astro/primitives/Config/Config";
  import type { ActiveSlotElement } from "@xrayman/shared/astro/primitives/ActiveSlot/ActiveSlot";

  class AddNodePage extends CustomElement implements Resettable {
    private configEl!: ConfigEditorElement;

    connectedCallback() {
      super.connectedCallback();

      this.configEl = pt<ConfigEditorElement>(this, "config");

      const submitBtn = pt<HTMLButtonElement>(this, "submit-btn");
      const submitBtnContent = pt<ActiveSlotElement>(this, "submit-btn-content");

      submitBtn.addEventListener("click", (e) => {
        e.preventDefault();
        form.requestSubmit();
      });

      const form = pt<HTMLFormElement>(this, "config-form");
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const value = this.configEl.value;
        const endpoint = value.endpoint as string;
        const accesskey = value.accesskey as string;
        if (endpoint.length == 0 || accesskey.length == 0) {
          return;
        }

        // reset and hide
        const response = await newNode(endpoint, accesskey);
        if (!response.ok) {
          notifyApiError("new_node", response.reason);
          submitBtnContent.value = undefined;
          return;
        }
        reloadNodes({ quiet: true });

        // show back
        submitBtnContent.value = "✓";
        setTimeout(() => {
          submitBtnContent.value = undefined;
        }, 2000);
      });
    }

    reset() {
      this.configEl.data = {};
    }
  }

  customElements.define("add-node-page", AddNodePage);
</script>
