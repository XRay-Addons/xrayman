---
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import Input from "@xrayman/shared/astro/primitives/Input.astro";
import Tag from "@xrayman/shared/astro/primitives/Tag.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";

interface Props {
  "data-part": string;
  "label-i18n": string;
}
const { "label-i18n": labelI18n = "", ...rest } = Astro.props;
---

<labeled-input {...rest}>
  <Info>
    <div class="d-inline-flex">
      <I18NText data-i18n={labelI18n} />
    </div>
  </Info>

  <Input data-part="input" class="mb-2" />

  <div data-part="placeholder-tags" class="d-flex flex-wrap gap-2 mb-2 h-center">
    <template data-part="placeholder-tag-tmpl">
      <div class="d-inline-flex">
        <Tag data-part="placeholder-tag">
          <span data-part="placeholder-tag-text"></span>
        </Tag>
      </div>
    </template>
  </div>
</labeled-input>

<script>
  import type { ResettableElement } from "@xrayman/shared/astro/types/Resettable";
  import type { LabeledInputElement } from "../types/LabeledInput";
  import { ptEl, PartedElement } from "@xrayman/shared/runtime/dom/parted-element";

  class LabeledInput extends PartedElement implements ResettableElement, LabeledInputElement {
    private inputEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.ptEl<HTMLInputElement>("input");
    }

    disconnectedCallback() {}

    async setPlaceholders(tags: string[]) {
      const tagTemplate = await this.ptWebComp<HTMLTemplateElement>("placeholder-tag-tmpl");
      const tagsSection = await this.ptWebComp<HTMLElement>("placeholder-tags");

      const frag = document.createDocumentFragment();

      tags.forEach((tag) => {
        const fragment = tagTemplate.content.cloneNode(true) as HTMLElement;
        const btn = ptEl<HTMLButtonElement>(fragment, "placeholder-tag");
        const text = ptEl<HTMLSpanElement>(fragment, "placeholder-tag-text");
        text.innerHTML = tag;

        // prevent input focus lose
        btn.addEventListener("mousedown", (e) => {
          e.preventDefault();
        });
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          this.addInputText(this.inputEl, tag);
        });
        frag.appendChild(fragment);
      });

      tagsSection.replaceChildren(frag);
    }

    addInputText(input: HTMLInputElement, text: string) {
      const start = input.selectionStart ?? input.value.length;
      const end = input.selectionEnd ?? input.value.length;

      input.blur();
      input.setRangeText(text, start, end, "end");
      input.focus();
    }

    getValue(): string {
      return this.inputEl.value;
    }

    setValue(v: string) {
      this.inputEl.value = v;
    }

    reset() {
      this.inputEl.value = "";
    }
  }

  customElements.define("labeled-input", LabeledInput);
</script>
