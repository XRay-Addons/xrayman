{
  "include": ["src"],
  "compilerOptions": {
    "module": "ESNext",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "moduleResolution": "Bundler",

    "paths": {
      "@/*": ["./src/*"],
      "@xrayman/shared/*": ["../shared/src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true
  },
  "extends": "astro/tsconfigs/strict"
}
