---
import Card from "@xrayman/shared/astro/primitives/Card.astro";
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import InputGroup from "@xrayman/shared/astro/primitives/InputGroup/InputGroup.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";

const i18n = "choosename";
---

<choose-name-card class="h-center">
  <Card class="col-12 mb-2">
    <Info>
      <I18NText data-i18n=`${i18n}.info` />
    </Info>

    <div class="h-center g-0 w-100">
      <InputGroup
        input:data-i18n-placeholder=`${i18n}.placeholder`
        btn:data-i18n=`${i18n}.btntext`
        data-name-input
        class="fluid-md"
      />
    </div>
  </Card>
</choose-name-card>

<script>
  import { newUser } from "@/services/api/client";
  import { stateSignal } from "@/state/signals";
  import { State } from "@/state/state";
  import { notifyApiError } from "@/runtime/notifications/use-notifications";
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { type InputGroupElement } from "@xrayman/shared/astro/primitives/InputGroup/InputGroup";
  import { pt } from "@xrayman/shared/runtime/dom/pts";

  class ChooseNameCard extends CustomElement {
    connectedCallback() {
      super.connectedCallback();
      const nameInputEl = pt<InputGroupElement>(this, "name-input");

      nameInputEl.submitfn = async (displayName: string) => {
        if (displayName.length == 0) {
          return;
        }

        const response = await newUser(displayName);
        if (response.ok) {
          stateSignal.set({ status: State.LoggedIn, data: response.data });
        } else if (response.ok == false) {
          // WTF typescript conditions
          notifyApiError("new_user", response.reason);
        }
      };
    }
  }

  customElements.define("choose-name-card", ChooseNameCard);
</script>
