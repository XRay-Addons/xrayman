---
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import type { HTMLAttributes } from "astro/types";
import WideListHeader from "./WideListHeader.astro";
import WideListRow from "./WideListRow.astro";
import type { ListInputProps } from "./ListInput";

type Props = ListInputProps;

const { name, i18n, fields, ...rest } = Astro.props;
---

<wide-list-input name={name} {...rest}>
  <table>
    <thead data-thead>
      <WideListHeader fields={fields} i18n={i18n} />
    </thead>

    <tbody data-tbody></tbody>

    <template data-row-template>
      <WideListRow
        fields={fields}
        input-pt="wide-list-input"
        btn-pt="remove-row-btn"
        tagged-pt="tagged-cell"
      />
    </template>
  </table>

  <Button btn:data-add-row-btn btn:type="button" class="mb-2">+</Button>
</wide-list-input>

<style>
  wide-list-input {
    display: block;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border-spacing: 0;
  }
</style>

<script>
  import { CustomElement, prop } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt, pts } from "@xrayman/shared/runtime/dom/pts";
  import type { TaggedInputElement } from "./../TaggedInput/TaggedInput";
  import type { ListInputElement } from "./ListInput";

  class WideListInput extends CustomElement implements ListInputElement {
    @prop({ default: [] }) tags!: string[];
    @prop({ default: [] }) data!: Record<string, string>[];

    private tbody!: HTMLElement;
    private rowTmpl!: HTMLTemplateElement;

    connectedCallback() {
      super.connectedCallback();

      this.tbody = pt<HTMLElement>(this, "tbody");
      this.rowTmpl = pt<HTMLTemplateElement>(this, "row-template");

      const addBtn = pt<HTMLButtonElement>(this, "add-row-btn");
      addBtn.addEventListener("click", (e) => {
        e.preventDefault();
        this.tbody.appendChild(this.makeRow({}));
      });
    }

    protected render() {
      const rows = this.data.map((v) => {
        return this.makeRow(v);
      });
      this.tbody.replaceChildren(...rows);
    }

    private makeRow(data: Record<string, string>): HTMLElement {
      const fragment = this.rowTmpl.content.cloneNode(true) as HTMLElement;
      const row = pt<HTMLTableRowElement>(fragment, "row");
      const taggedInputs = pts<TaggedInputElement>(row, "tagged-cell");
      taggedInputs.forEach((input) => {
        input.tags = this.tags;
      });

      Object.entries(data).forEach(([key, value]) => {
        const input = row.querySelector<HTMLInputElement>(`[name="${key}"]`);
        if (input) input.value = value;
      });

      const removeBtn = pt<HTMLButtonElement>(fragment, "remove-row-btn");
      removeBtn.onclick = () => {
        row.remove();
      };

      return fragment;
    }

    get value(): Record<string, string>[] {
      return pts<HTMLTableRowElement>(this, "row").map((row) => {
        const record: Record<string, string> = {};
        const cells = pts<HTMLInputElement>(row, "wide-list-input");
        cells.map((cell) => {
          record[cell.name] = cell.value;
        });
        return record;
      });
    }
  }

  customElements.define("wide-list-input", WideListInput);
</script>
