---
import type { ListItemField } from "./ListInput";
import Input from "@xrayman/shared/astro/primitives/Input.astro";
import TaggedInput from "@xrayman/shared/astro/primitives/TaggedInput/TaggedInput.astro";
import Button from "@xrayman/shared/astro/primitives/Button.astro";

interface Props {
  fields: ListItemField[];
  "btn-pt": string;
  "tagged-pt": string;
  "input-pt": string;
}

const { fields, "input-pt": inputPt, "btn-pt": btnPt, "tagged-pt": taggedPt } = Astro.props;
---

<tr data-row>
  {
    fields.map(({ name, type, inputProps = {} }) => {
      const props = {
        class: "h-100",
        "input:name": name,
        "input:data-pt": inputPt,
        input: inputProps,
      };

      let component;

      switch (type) {
        case "input":
          component = <Input {...props} />;
          break;
        case "tagged-input":
          component = <TaggedInput tagged:data-pt={taggedPt} {...props} />;
          break;
      }

      return (
        <td>
          <div class="cell">{component}</div>
        </td>
      );
    })
  }

  <td>
    <div class="last-cell">
      <Button btn:type="button" btn:data-pt={btnPt} class="h-100"> - </Button>
    </div>
  </td>
</tr>

<style>
  /* weird stuff to make all cells equal-heights */
  tr {
    height: 1px;
  }

  td {
    padding: 0;
    border-collapse: collapse;
    vertical-align: top;
    height: inherit;
  }

  .cell,
  .last-cell {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding-bottom: 0.25rem;
  }

  .cell {
    margin-right: calc(-1 * var(--surface-depth));
  }
</style>
