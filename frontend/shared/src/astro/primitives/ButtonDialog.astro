---
import Button from "@xrayman/shared/astro/primitives/Button.astro";

interface Props {
  class?: string;
  "content-class"?: string;
}
const { class: extraClass = "", "content-class": contentClass = "" } = Astro.props;
---

<btn-dialog>
  <div class={extraClass}>
    <Button data-app-dialog-button class={contentClass}>
      <slot name="button" />
    </Button>
  </div>

  <dialog class="app-dialog" data-app-dialog>
    <div class="app-dialog-overlay" data-app-dialog-overlay></div>
    <div class="app-dialog-page h-center" data-app-dialog-page>
      <slot name="page" />
    </div>
  </dialog>
</btn-dialog>

<script>
  import { CustomElement, prop } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";

  class BtnDialog extends CustomElement {
    private button!: HTMLButtonElement;
    private dialog!: HTMLDialogElement;
    private page!: HTMLElement;

    connectedCallback() {
      this.button = pt<HTMLButtonElement>(this, "app-dialog-button");
      this.dialog = pt<HTMLDialogElement>(this, "app-dialog");
      this.page = pt<HTMLElement>(this, "app-dialog-page");

      this.button.onclick = async () => {
        this.dialog.showModal();
      };

      this.dialog.addEventListener("close", () => {
        this.reset();
      });

      const overlay = pt<HTMLElement>(this, "app-dialog-overlay");
      overlay.onclick = () => {
        this.dialog.close();
        this.reset();
      };
    }

    disconnectedCallback() {}

    protected render() {}

    private reset() {
      Array.from(this.page.children).forEach((el) => {
        const resettable = el as any;
        if (typeof resettable.reset === "function") {
          resettable.reset();
        }
      });
    }
  }

  customElements.define("btn-dialog", BtnDialog);
</script>

<style>
  btn-dialog {
    display: contents;
  }

  .app-dialog {
    background: transparent;
    border: none;
    width: 100%;
    max-width: 100%;
    padding: 0;
  }

  .app-dialog::backdrop {
    background: transparent;
  }
  .app-dialog-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.5);
  }
</style>
