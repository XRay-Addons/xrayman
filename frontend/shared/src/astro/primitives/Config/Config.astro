---
import Input from "@xrayman/shared/astro/primitives/Input.astro";
import TextInput from "@xrayman/shared/astro/primitives/TextInput.astro";
import TaggedInput from "@xrayman/shared/astro/primitives/TaggedInput/TaggedInput.astro";
import { type ListItemField } from "@xrayman/shared/astro/primitives/ListInput/ListInput";
import WideListInput from "@xrayman/shared/astro/primitives/ListInput/WideListInput.astro";
import NarrowListInput from "@xrayman/shared/astro/primitives/ListInput/NarrowListInput.astro";
import type { HTMLAttributes, ComponentProps } from "astro/types";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";

type FieldType = "input" | "tagged-input" | "list-input";
type InputAttrs = Omit<ComponentProps<typeof TextInput>, "name">;

interface Field {
  name: string;
  type: FieldType;
}

export interface InputField extends Field {
  placeholder?: boolean;
  inputProps?: InputAttrs;
}

export interface ListField extends Field {
  listInputs: ListItemField[];
}

type FormProps = WithPrefix<HTMLAttributes<"form">, "form">;
type HostProps = HTMLAttributes<"div">;

interface Props extends FormProps, HostProps {
  i18n: string;
  fields: (InputField | ListField)[];
}

const { i18n, fields, ...props } = Astro.props;
const { ...formProps } = ExtractPrefixed(props, "form");
---

<config-editor {...props}>
  <form data-config-form {...formProps}>
    {
      fields.map((field) => {
        let component;
        switch (field.type) {
          case "input": {
            const p = field as InputField;
            component = (
              <Input
                input={{
                  name: p.name,
                  "data-config-input": true,
                  ...(p.placeholder && {
                    "data-i18n-placeholder": `${i18n}.fields.${p.name}-placeholder`,
                  }),
                  ...(p.inputProps ?? {}),
                }}
              />
            );
            break;
          }
          case "tagged-input": {
            const p = field as InputField;
            component = (
              <TaggedInput
                data-config-tagged-input
                input:name={p.name}
                input:data-config-input
                input={{ ...(p.inputProps ?? {}) }}
              />
            );
            break;
          }
          case "list-input": {
            const p = field as ListField;
            component = (
              <div class="list-input">
                <WideListInput
                  name={p.name}
                  data-config-wide-list-input
                  i18n={`${i18n}.fields.${p.name}`}
                  fields={p.listInputs}
                  hidden
                />
                <NarrowListInput
                  name={p.name}
                  data-config-narrow-list-input
                  i18n={`${i18n}.fields.${p.name}`}
                  fields={p.listInputs}
                  hidden
                />
              </div>
            );
            break;
          }
        }
        const i18nKey =
          field.type === "list-input"
            ? `${i18n}.fields.${field.name}.title`
            : `${i18n}.fields.${field.name}`;

        return (
          <Fragment>
            <Info>
              <I18NText data-i18n={i18nKey} />
            </Info>
            {component}
          </Fragment>
        );
      })
    }
  </form>
</config-editor>

<style>
  config-editor {
    display: block;
  }

  .list-input,
  .narrow-list-input {
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    background-color: rgba(0, 0, 0, 0.05);
    border: 2px solid rgba(0, 0, 0, 0.25);
  }
</style>

<script>
  import { CustomElement, prop } from "@xrayman/shared/runtime/dom/custom-element";
  import { pts } from "@xrayman/shared/runtime/dom/pts";
  import type { TaggedInputElement } from "@xrayman/shared/astro/primitives/TaggedInput/TaggedInput";
  import type { ListInputElement } from "@xrayman/shared/astro/primitives/ListInput/ListInput";
  import type { ConfigData, ConfigEditorElement } from "./Config";

  class ConfigEditor extends CustomElement implements ConfigEditorElement {
    @prop({ default: [] }) tags!: string[];
    @prop({ default: [] }) data!: ConfigData;

    private inputs!: HTMLInputElement[];
    private taggedInputs!: TaggedInputElement[];
    private listInputs!: ListInputElement[];

    connectedCallback() {
      super.connectedCallback();

      this.inputs = pts<HTMLInputElement>(this, "config-input");
      this.taggedInputs = pts<TaggedInputElement>(this, "config-tagged-input");

      // select list inputs type - ordinary or narrow
      const narrowScreenSize = 768; // Bootstrap MD
      const listInputsType =
        window.innerWidth > narrowScreenSize
          ? "config-wide-list-input"
          : "config-narrow-list-input";
      this.listInputs = pts<ListInputElement>(this, listInputsType);
      this.listInputs.forEach((element) => {
        element.hidden = false;
      });
    }

    protected render() {
      // set inputs
      this.inputs.forEach((input) => {
        const key = input.getAttribute("name");
        if (key) {
          const value = this.data[key];
          input.value = typeof value === "string" ? value : "";
        }
      });
      // set tags for tagged inputs
      this.taggedInputs.forEach((taggedInput) => {
        taggedInput.tags = this.tags;
      });

      // setup list inputs
      this.listInputs.forEach((listInput) => {
        const key = listInput.getAttribute("name");
        if (key) {
          const value = this.data[key];
          listInput.data = Array.isArray(value) ? value : [];
        }
        listInput.tags = this.tags;
      });
    }

    get value(): ConfigData {
      const data: ConfigData = {};
      // get inputs
      this.inputs.forEach((input) => {
        const key = input.getAttribute("name");
        if (key) data[key] = input.value;
      });
      // get list inputs
      this.listInputs.forEach((listInput) => {
        const key = listInput.getAttribute("name");
        if (key) data[key] = listInput.value;
      });
      return data;
    }
  }

  customElements.define("config-editor", ConfigEditor);
</script>
