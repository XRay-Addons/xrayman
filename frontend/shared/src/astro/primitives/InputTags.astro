---
import Tag from "@xrayman/shared/astro/primitives/Tag.astro";

interface Props {}

const { ...rest } = Astro.props;
---

<input-tags {...rest}>
  <div data-part="tags-container" class="d-flex flex-wrap gap-2 mb-2 h-center"></div>

  <template data-part="tag-template">
    <div class="d-inline-flex">
      <Tag data-part="tag">
        <span data-part="tag-text"></span>
      </Tag>
    </div>
  </template>

  <script>
    import { CustomElement, prop } from "../../runtime/dom/custom-element";
    import { ptEl } from "../../runtime/dom/parted-element";
    import { InputTagsElement, InputTagsInit } from "../types/InputTags";

    class InputTags extends CustomElement implements InputTagsElement {
      @prop accessor init!: InputTagsInit;

      private tagsContainer!: HTMLElement;
      private tagTemplate!: HTMLTemplateElement;

      connectedCallback() {
        super.connectedCallback();
        this.tagsContainer = ptEl<HTMLElement>(this, "tags-container");
        this.tagTemplate = ptEl<HTMLTemplateElement>(this, "tag-template");
      }

      protected render() {
        if (!this.init) return;

        const items = this.init.tags.map((tag) => {
          const fragment = this.tagTemplate.content.cloneNode(true) as HTMLElement;
          const btn = ptEl<HTMLButtonElement>(fragment, "tag");
          const text = ptEl<HTMLSpanElement>(fragment, "tag-text");
          text.innerHTML = tag;

          btn.addEventListener("mousedown", (e) => {
            e.preventDefault();
          });
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            this.addInputText(tag);
          });

          return fragment;
        });

        this.tagsContainer.replaceChildren(...items);
      }

      private addInputText(text: string) {
        const input = this.init!.input!;
        const start = input.selectionStart ?? input.value.length;
        const end = input.selectionEnd ?? input.value.length;

        input.blur();
        input.setRangeText(text, start, end, "end");
        input.focus();
      }
    }

    customElements.define("input-tags", InputTags);
  </script>
</input-tags>
