---
import Surface from "./Surface.astro";

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  style?: string;
}

const { class: extraClass, style: __, type, ...rest } = Astro.props;
---

<Surface depth="var(--button-depth)" color="var(--button-color)" class={extraClass} dynamic>
  <button class="ui-reset-button noselect w-100 h-100 text text-md crt p-2" {...rest}>
    <slot />
  </button>
</Surface>
