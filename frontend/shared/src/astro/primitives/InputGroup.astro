---
import Surface from "./Surface.astro";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import type { HTMLAttributes } from "astro/types";

type FormProps = WithPrefix<HTMLAttributes<"form">, "form">;
type BtnProps = WithPrefix<HTMLAttributes<"button">, "btn">;
type InputProps = WithPrefix<HTMLAttributes<"input">, "input">;
type HostProps = HTMLAttributes<"div">;

interface Props extends HostProps, FormProps, BtnProps, InputProps {}

const { ...props } = Astro.props;
const { class: __form, ...formProps } = ExtractPrefixed(props, "form");
const { class: __btn, ...btnProps } = ExtractPrefixed(props, "btn");
const { class: __input, ...inputProps } = ExtractPrefixed(props, "input");
---

<form data-part="form" class="d-flex g-0" {...formProps}>
  <div class="group-input-wrap">
    <Surface depth="var(--input-depth)" color="var(--input-color)" class="h-100">
      <input class="ui-reset-input group-input text text-md crt p-2 h-100 w-100" {...inputProps} />
    </Surface>
  </div>

  <div class="group-btn-wrap">
    <Surface
      depth="var(--input-depth)"
      color="var(--input-color)"
      dynamic
      class="group-btn-wrap h-100 w-100"
    >
      <button
        class="ui-reset-button noselect group-btn text text-md crt p-2 h-100 w-100"
        type="button"
        {...btnProps}></button>
    </Surface>
  </div>
</form>

<style>
  .group-input-wrap {
    width: 75%;
  }
  .group-btn-wrap {
    width: calc(25% + var(--input-depth));
    margin-left: calc(-1 * var(--input-depth));
  }

  .group-input {
  }

  .group-btn {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

