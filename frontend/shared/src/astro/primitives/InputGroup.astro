---
import Surface from "./Surface.astro";

interface Props {
  "input-props"?: astroHTML.JSX.InputHTMLAttributes;
  "button-props"?: astroHTML.JSX.InputHTMLAttributes;
  [key: string]: unknown; // WTF ts can't guess types
}

const { "input-props": inputProps = {}, "button-props": buttonProps = {}, ...rest } = Astro.props;

const { class: _ic, style: _is, "data-part": _dpInput, ...safeInputProps } = inputProps;

const { class: _bc, style: _bs, "data-part": _dpButton, ...safeButtonProps } = buttonProps;
---

<input-group {...rest}>
  <form data-part="form" class="d-flex g-0">
    <div class="group-input-wrap">
      <Surface depth="var(--input-depth)" color="var(--input-color)" class="h-100">
        <input
          data-part="input"
          type="text"
          class="ui-reset-input group-input text text-md crt p-2 h-100 w-100"
          {...safeInputProps}
        />
      </Surface>
    </div>

    <div class="group-btn-wrap">
      <Surface
        depth="var(--input-depth)"
        color="var(--input-color)"
        dynamic
        class="group-btn-wrap h-100"
      >
        <button
          data-part="button"
          class="ui-reset-button noselect group-btn text text-md crt p-2 h-100 w-100"
          type="submit"
          {...safeButtonProps}></button>
      </Surface>
    </div>
  </form>
</input-group>

<style>
  .group-input-wrap {
    width: 75%;
  }
  .group-btn-wrap {
    width: calc(25% + var(--input-depth));
    margin-left: calc(-1 * var(--input-depth));
  }

  .group-input {
  }

  .group-btn {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { type InputGroupElement, type OnClickFn } from "../types/InputGroup";
  import { PartedElement, ptEl } from "../../runtime/dom/parted-element";
  import { CustomElement, prop } from "../../runtime/dom/custom-element";

  class InputGroup extends CustomElement implements InputGroupElement {
    @prop accessor value: string = "";
    @prop accessor onclickfn!: OnClickFn;

    private inputEl!: HTMLInputElement;
    private btnEl!: HTMLButtonElement;
    private formEl!: HTMLFormElement;

    public connectedCallback() {
      super.connectedCallback();
      this.inputEl = this.pt<HTMLInputElement>("input");
      this.btnEl = this.pt<HTMLButtonElement>("button");
      this.formEl = this.pt<HTMLFormElement>("form");
      this.formEl.addEventListener("submit", async (e: Event) => {
        e.preventDefault();
        await this.onclickfn?.(this.inputEl.value);
      });
    }

    public get input(): HTMLInputElement {
      return this.inputEl;
    }

    public get button(): HTMLButtonElement {
      return this.btnEl;
    }

    protected render(): void {
      this.inputEl.value = this.value;
    }

    disconnectedCallback() {}
  }

  customElements.define("input-group", InputGroup);
</script>
