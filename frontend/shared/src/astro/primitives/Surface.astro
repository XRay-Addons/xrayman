---
import type { HTMLAttributes } from "astro/types";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";

type InProps = WithPrefix<HTMLAttributes<"div">, "in">;
type HostProps = HTMLAttributes<"div">;

interface Props extends InProps, HostProps {
  dynamic?: boolean;
  depth?: string;
  color?: string;
}

const { ...props } = Astro.props;
const { class: inClass, ...inProps } = ExtractPrefixed(props, "in");
const {
  dynamic = false,
  depth = "0px",
  color = "transparent",
  class: hostClass,
  ...hostProps
} = props;

const styleVars = {
  ...(color && { "--surface-color": color }),
  ...(depth && { "--surface-depth": depth }),
};
---

<div class:list={["surface-out", hostClass]} style={styleVars} {...hostProps}>
  <div class:list={["surface-in", inClass, { "surface-dynamic": dynamic }]} {...inProps}>
    <slot />
  </div>
</div>

<style lang="scss">
  @use "../../styles/shades.scss" as *;

  .surface-in {
    position: relative;
    height: 100%;
    width: 100%;
  }

  .surface-in {
    border-width: 1px;
    border-style: solid;
    border-color: dddarker(var(--surface-color));
    background-color: var(--surface-color);
    color: contrasted(var(--surface-color));
  }

  .surface-out {
    break-inside: avoid;
    page-break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  .surface-out {
    position: relative;
    padding-right: var(--surface-depth);
    padding-bottom: var(--surface-depth);
  }

  .surface-out::before {
    content: "";
    position: absolute;

    inset: 0;
    margin-left: var(--surface-depth);
    margin-top: var(--surface-depth);

    background-color: dddarker(var(--surface-color));
  }

  .surface-dynamic {
    transition: transform 200ms ease;
  }

  @media (any-hover: hover) {
    .surface-dynamic:hover {
      background-color: darker(var(--surface-color));
      transform: translate(calc(var(--surface-depth) / 2), calc(var(--surface-depth) / 2));
    }
  }

  .surface-dynamic:active {
    background-color: ddarker(var(--surface-color));
    transform: translate(var(--surface-depth), var(--surface-depth));
  }

  :global(.surface-out input) {
    background-color: llllighter(var(--surface-color));
    color: ddddarker(var(--surface-color));
  }

  @media (prefers-reduced-motion: reduce) {
    .surface-dynamic {
      transition: none;
    }
  }
</style>
