---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import Input from "@xrayman/shared/astro/primitives/Input.astro";
import TextInput from "@xrayman/shared/astro/primitives/TextInput.astro";
import Surface from "@xrayman/shared/astro/primitives/Surface.astro";

type InputProps = WithPrefix<ComponentProps<typeof TextInput>, "input">;
type HostProps = HTMLAttributes<"div">;

interface Props extends InputProps, HostProps {}

const { ...props } = Astro.props;
const { ...inputProps } = ExtractPrefixed(props, "input");
---

<tagged-input {...props}>
  <Input data-input-container input:data-tagged-input input={{ ...inputProps }} />

  <div data-tags-container class="tags-container" hidden>
    <Surface depth="var(--input-depth)" color="var(--input-color)">
      <div data-tags class="d-flex flex-wrap gap-2 m-1 h-center"></div>

      <template data-tag-template>
        <button
          data-tag-btn
          type="button"
          class="tag ui-reset-button noselect text text-xs crt p-1"
        >
        </button>
      </template>
    </Surface>
  </div>
</tagged-input>

<script>
  import { CustomElement, prop } from "@xrayman/shared/runtime/dom/custom-element";
  import type { TaggedInputElement } from "./TaggedInput";
  import { pt } from "@xrayman/shared/runtime/dom/pts";

  class TaggedInput extends CustomElement implements TaggedInputElement {
    @prop({ default: [] }) tags!: string[];

    private inputEl!: HTMLInputElement;
    private tagsEl!: HTMLElement;
    private tagTmpl!: HTMLTemplateElement;

    connectedCallback() {
      super.connectedCallback();

      this.inputEl = pt<HTMLInputElement>(this, "tagged-input");
      this.tagsEl = pt<HTMLElement>(this, "tags");
      this.tagTmpl = pt<HTMLTemplateElement>(this, "tag-template");

      const tagsContainerEl = pt<HTMLElement>(this, "tags-container");
      const inputContainerEl = pt<HTMLElement>(this, "input-container");

      this.inputEl.addEventListener("focus", () => {
        tagsContainerEl.removeAttribute("hidden");
      });
      this.inputEl.addEventListener("blur", () => {
        tagsContainerEl.setAttribute("hidden", "");
      });
      this.inputEl.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        event.preventDefault();
        this.inputEl.blur();
      });
      tagsContainerEl.addEventListener("mousedown", (event) => {
        event.preventDefault();
      });

      this.render();
    }

    protected render() {
      this.renderTags();
    }

    private renderTags() {
      const tags = this.tags.map((ph) => {
        const tag = this.tagTmpl.content.cloneNode(true) as HTMLElement;
        const btn = pt<HTMLButtonElement>(tag, "tag-btn");
        btn.textContent = ph;
        btn.addEventListener("click", () => {
          this.addInputText(ph);
        });
        return tag;
      });
      this.tagsEl.replaceChildren(...tags);
    }

    private addInputText(text: string) {
      const input = this.inputEl!;
      const start = input.selectionStart ?? input.value.length;
      const end = input.selectionEnd ?? input.value.length;
      input.setRangeText(text, start, end, "end");
    }
  }

  if (!customElements.get("tagged-input")) {
    customElements.define("tagged-input", TaggedInput);
  }
</script>

<style lang="scss">
  @use "@xrayman/shared/styles/shades.scss" as *;

  tagged-input {
    display: block;
    position: relative;
  }

  .tags-container {
    position: absolute;
    z-index: 1;
    top: 100%;
    width: 100%;

    margin-top: calc(-1 * var(--input-depth));
  }

  .tag {
    border: 1px solid dddarker(var(--button-color));
    background-color: var(--button-color);
    color: contrasted(var(--button-color));
  }

  @media (any-hover: hover) {
    .tag:hover {
      background-color: darker(var(--button-color));
    }
  }

  .tag:active {
    background-color: ddarker(var(--button-color));
  }
</style>
