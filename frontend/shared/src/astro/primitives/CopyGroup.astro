---
import InputGroup from "./InputGroup.astro";

interface Props {
  "input-props"?: astroHTML.JSX.InputHTMLAttributes;
  "button-props"?: astroHTML.JSX.InputHTMLAttributes;
  "data-part"?: string;
  [key: string]: unknown; // WTF ts can't guess types
}

const {
  "input-props": inputProps = {},
  "button-props": buttonProps = {},
  "data-part": dataPart = undefined,
  ...rest
} = Astro.props;
---

<copy-group data-part={dataPart}>
  <InputGroup
    input-props={{
      readonly: "true",
      ...inputProps,
    }}
    button-props={{
      ...buttonProps,
    }}
    data-part="input-group"
    {...rest}
  />
</copy-group>

<style lang="css">
  copy-group {
    display: contents;
  }
</style>

<script>
  import { LitElement, html, render, PropertyValues } from "lit";

  import { type CopyGroupElement } from "../types/CopyGroup";
  import type { InputGroupElement } from "../types/InputGroup";
  import { PartedElement, ptEl } from "../../runtime/dom/parted-element";
  import { CustomElement, prop } from "../../runtime/dom/custom-element";

  class CopyGroup extends CustomElement implements CopyGroupElement {
    @prop accessor value: string = "";

    private inputGroupEl!: InputGroupElement;

    connectedCallback() {
      super.connectedCallback();

      this.inputGroupEl = this.pt<InputGroupElement>("input-group");
      const copyBtnEl = this.inputGroupEl.button;
      const originalContent = copyBtnEl.innerHTML;

      this.inputGroupEl.onclickfn = async (val: string) => {
        try {
          this.inputGroupEl.style.pointerEvents = "none";
          await navigator.clipboard.writeText(val);
          copyBtnEl.innerHTML = "✓";
          setTimeout(() => {
            copyBtnEl.innerHTML = originalContent;
          }, 2000);
        } catch (err) {
          console.error("Clipboard error", err);
        } finally {
          this.inputGroupEl.style.pointerEvents = "auto";
        }
      };
    }

    protected render() {
      this.inputGroupEl.value = this.value;
    }

    disconnectedCallback() {}
  }

  customElements.define("copy-group", CopyGroup);
</script>
