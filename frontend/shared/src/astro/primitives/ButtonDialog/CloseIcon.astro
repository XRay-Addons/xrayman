<div class="close-icon"></div>

<style>
  .close-icon {
    width: calc(1rem + var(--card-depth));
    height: calc(1rem + var(--card-depth));

    color: contrasted(var(--bg-color));
    background-color: var(--bg-color);

    border: 1px solid currentColor;

    padding: 1px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    cursor: pointer;
  }

  /* Close cross lines */
  .close-icon::before,
  .close-icon::after {
    content: "";
    position: absolute;

    width: calc(100% - 2px);

    height: 3px;

    background-color: currentColor;
  }

  .close-icon::before {
    transform: rotate(45deg);
  }

  .close-icon::after {
    transform: rotate(-45deg);
  }
</style>
