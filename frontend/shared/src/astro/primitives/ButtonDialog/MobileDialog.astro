---
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import type { HTMLAttributes } from "astro/types";
import Button from "@xrayman/shared/astro/primitives/Button.astro";

type PageProps = HTMLAttributes<"div">;
type DlgProps = WithPrefix<HTMLAttributes<"dialog">, "dlg">;

interface Props extends PageProps, DlgProps {}

const { ...props } = Astro.props;
const { class: dlgClass, ...dlgProps } = ExtractPrefixed(props, "dlg");
---

<mobile-dialog>
  <dialog class:list={["app-dialog", dlgClass]} data-app-mobile-dialog {...dlgProps}>
    <div class="p-2 app-dialog-page" data-dialog-page>
      <div {...props}>
        <slot name="page" />
      </div>
    </div>

    <div class="p-2 app-dialog-footer">
      <Button btn:data-dialog-close>Close</Button>
    </div>
  </dialog>
</mobile-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { Resettable } from "./ButtonDialog";

  class MobileDialog extends CustomElement {
    private page!: HTMLElement;
    private dialog!: HTMLDialogElement;
    private isClosing: boolean = false;

    connectedCallback() {
      this.page = pt<HTMLElement>(this, "dialog-page");
      this.dialog = pt<HTMLDialogElement>(this, "app-mobile-dialog");
      const closeButton = pt<HTMLButtonElement>(this, "dialog-close");

      const originalShowModal = this.dialog.showModal.bind(this.dialog);
      this.dialog.showModal = () => {
        this.lockScroll();
        originalShowModal();
      };

      this.dialog.addEventListener("close", () => {
        this.unlockScroll();
        this.reset();
      });

      closeButton.addEventListener(
        "pointerdown",
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.closeWithGuard();
        },
        { passive: false },
      );
    }

    private lockScroll() {
      document.body.style.position = "fixed";
    }

    private unlockScroll() {
      document.body.style.position = "";
    }
    private closeWithGuard() {
      this.isClosing = true;
      this.dialog.close();

      // lock clicks for closing to avoid fantom bg clicks
      document.addEventListener(
        "click",
        (e) => {
          if (this.isClosing) {
            e.preventDefault();
            e.stopPropagation();
            this.isClosing = false;
          }
        },
        { capture: true, once: true },
      );
    }

    private reset() {
      Array.from(this.page.children).forEach((el) => {
        (el as Partial<Resettable>).reset?.();
      });
    }
  }

  customElements.define("mobile-dialog", MobileDialog);
</script>

<style lang="scss">
  @use "@xrayman/shared/styles/shades.scss" as *;

  mobile-btn-dialog {
    display: contents;
  }

  .app-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    padding: 0;
    border: none;

    width: 100dvw;
    max-width: 100dvw;
    height: 100dvh;
    max-height: 100dvh;

    background-color: var(--bg-color);

    touch-action: none;
    overscroll-behavior: none;

    display: none;
    flex-direction: column;

    &[open] {
      display: flex;
    }
  }

  .app-dialog-page {
    flex: 1 1 auto;
    min-height: 0;

    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;

    padding-top: env(safe-area-inset-top);

    outline: none;
  }

  .app-dialog-footer {
    flex-shrink: 0;
    width: 100%;

    padding-bottom: env(safe-area-inset-bottom);

    background-color: var(--bg-color);
  }
</style>
