---
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import Surface from "@xrayman/shared/astro/primitives/Surface.astro";
import type { HTMLAttributes } from "astro/types";

type PageProps = HTMLAttributes<"div">;
type DlgProps = WithPrefix<HTMLAttributes<"dialog">, "dlg">;

interface Props extends PageProps, DlgProps {
  pt: string;
}

const { pt, ...props } = Astro.props;
const { class: dlgClass, ...dlgProps } = ExtractPrefixed(props, "dlg");
const { class: pageClass, ...pageProps } = props;
---

<desktop-dialog data-pt={pt}>
  <dialog class:list={["app-dialog", dlgClass]} data-app-desktop-dialog {...dlgProps}>
    <div class="app-dialog-page p-2" data-dialog-page>
      <div class:list={["dialog-surface-wrapper", pageClass]} {...pageProps}>
        <Surface in:class="p-2" color="var(--bg-color)" in:data-dialog-content>
          <slot name="page" />
        </Surface>
      </div>
    </div>
  </dialog>
</desktop-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { DialogItemElement } from "./ButtonDialog";
  import type { DialogElement } from "./ButtonDialog";

  class DesktopDialog extends CustomElement implements DialogElement {
    private dialog!: HTMLDialogElement;
    private page!: HTMLElement;

    connectedCallback() {
      console.log("open dialog");
      this.dialog = pt<HTMLDialogElement>(this, "app-desktop-dialog");
      this.page = pt<HTMLElement>(this, "dialog-page");

      this.page.onmousedown = (e) => {
        if (e.target === this.page) {
          this.dialog.close();
        }
      };
    }

    async showModal() {
      const dialogContent = pt<HTMLElement>(this, "dialog-content");
      for (const el of dialogContent.children) {
        await (el as Partial<DialogItemElement>).onShow?.();
      }
      this.dialog.showModal();
    }
  }

  customElements.define("desktop-dialog", DesktopDialog);
</script>

<style>
  desktop-dialog {
    display: contents;
  }

  .app-dialog {
    background: rgba(255, 255, 255, 0.5);
    border: none;

    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
  }

  .app-dialog::backdrop {
    background: transparent;
  }

  .app-dialog-page {
    position: absolute;
    inset: 0;

    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;

    flex-direction: column;

    display: flex;
    align-items: center;

    justify-content: safe center; /* Desktop only */
  }

  .dialog-surface-wrapper {
    position: relative;
  }

  .app-dialog-close {
    position: absolute;
    top: 0;
    right: 0;

    border: none;
    cursor: pointer;
    padding: 0px;
  }
</style>
