---
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import type { HTMLAttributes } from "astro/types";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import type { ComponentProps } from "astro/types";
import Surface from "../Surface.astro";
import CloseIcon from "./CloseIcon.astro";

type BtnProps = ComponentProps<typeof Button>;
type PageProps = WithPrefix<HTMLAttributes<"div">, "page">;

interface Props extends BtnProps, PageProps {}

const { ...props } = Astro.props;
const { class: pageClass, ...pageProps } = ExtractPrefixed(props, "page");
---

<btn-dialog>
  <Button data-dialog-button {...props}>
    <slot name="button" />
  </Button>

  <dialog class="app-dialog" data-dialog>
    <div class="app-dialog-page" data-dialog-page>
      <div class:list={["dialog-surface-wrapper", pageClass]} {...pageProps}>
        <Surface class="m-2" in:class="p-2" depth="var(--card-depth)" color="var(--bg-color)">
          <slot name="page" />
        </Surface>
        <button type="button" class="app-dialog-close" data-dialog-close>
          <CloseIcon />
        </button>
      </div>
    </div>
  </dialog>
</btn-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { Resettable } from "./ButtonDialog";

  class BtnDialog extends CustomElement {
    private button!: HTMLButtonElement;
    private dialog!: HTMLDialogElement;
    private page!: HTMLElement;
    private closeBtn!: HTMLButtonElement;

    connectedCallback() {
      this.button = pt<HTMLButtonElement>(this, "dialog-button");
      this.dialog = pt<HTMLDialogElement>(this, "dialog");
      this.page = pt<HTMLElement>(this, "dialog-page");
      this.closeBtn = pt<HTMLButtonElement>(this, "dialog-close");

      this.button.onclick = async () => {
        this.dialog.showModal();
      };

      this.dialog.addEventListener("close", () => {
        this.reset();
      });

      const close = () => {
        this.dialog.close();
      };

      this.closeBtn.onclick = () => {
        close();
      };

      this.page.onmousedown = (e) => {
        if (e.target === this.page) {
          close();
        }
      };
    }

    private reset() {
      const wrapper = this.page.querySelector(".dialog-surface-wrapper");
      const target = wrapper || this.page;

      Array.from(target.children).forEach((el) => {
        if (el === this.closeBtn) return;
        (el as Partial<Resettable>).reset?.();
      });
    }
  }

  customElements.define("btn-dialog", BtnDialog);
</script>

<style lang="scss">
  @use "@xrayman/shared/styles/shades.scss" as *;

  btn-dialog {
    display: contents;
  }

  .app-dialog {
    background: rgba(255, 255, 255, 0.5);
    border: none;

    width: 100dvw;
    max-width: 100dvw;
    height: 100dvh;
    max-height: 100dvh;
  }

  .app-dialog::backdrop {
    background: transparent;
  }

  .app-dialog-page {
    position: absolute;
    inset: 0;

    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;

    flex-direction: column;

    display: flex;
    align-items: center;

    justify-content: safe center; /* Desktop only */
  }

  .dialog-surface-wrapper {
    position: relative;
  }

  .app-dialog-close {
    position: absolute;
    top: 0;
    right: 0;

    border: none;
    cursor: pointer;
    padding: 0px;

    display: flex;
    background: transparent;
  }
</style>
