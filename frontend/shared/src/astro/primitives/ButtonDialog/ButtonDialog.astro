---
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import type { HTMLAttributes } from "astro/types";
import type { ComponentProps } from "astro/types";
import { ExtractPrefixed, type WithPrefix } from "@xrayman/shared/astro/props/props";
import Card from "@xrayman/shared/astro/primitives/Card.astro";

type BtnProps = ComponentProps<typeof Button>;
type DlgProps = WithPrefix<HTMLAttributes<"div">, "dlg">;

interface Props extends DlgProps, BtnProps {}

const { ...props } = Astro.props;
const { dlgClass, ...dlgProps } = ExtractPrefixed(props, "dlg");
---

<btn-dialog>
  <Button data-dialog-button {...props}>
    <slot name="button" />
  </Button>

  <dialog class="app-dialog" data-dialog>
    <div class="app-dialog-overlay" data-overlay></div>

    <div class="app-dialog-page h-center" data-dialog-page>
      <div {...dlgProps}>
        <slot name="page" />
      </div>
    </div>
  </dialog>
</btn-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { Resettable } from "./ButtonDialog";

  class BtnDialog extends CustomElement {
    private button!: HTMLButtonElement;
    private dialog!: HTMLDialogElement;
    private page!: HTMLElement;

    connectedCallback() {
      this.button = pt<HTMLButtonElement>(this, "dialog-button");
      this.dialog = pt<HTMLDialogElement>(this, "dialog");
      this.page = pt<HTMLElement>(this, "dialog-page");

      this.button.onclick = async () => {
        this.dialog.showModal();
      };

      this.dialog.addEventListener("close", () => {
        this.reset();
      });

      const close = () => {
        this.dialog.close();
        this.reset();
      };

      const overlay = pt<HTMLElement>(this, "overlay");
      overlay.onclick = close;

      overlay.onwheel = (e) => {
        e.preventDefault();
      };
      overlay.ontouchmove = (e) => {
        e.preventDefault();
      };
    }

    private reset() {
      Array.from(this.page.children).forEach((el) => {
        (el as Partial<Resettable>).reset?.();
      });
    }
  }

  customElements.define("btn-dialog", BtnDialog);
</script>

<style>
  btn-dialog {
    display: contents;
  }

  .app-dialog {
    background: transparent;
    border: none;
    width: 100%;
    max-width: 100%;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .app-dialog::backdrop {
    background: transparent;
  }
  .app-dialog-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.5);
  }
</style>
