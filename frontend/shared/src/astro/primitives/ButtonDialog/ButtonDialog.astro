---
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import MobileDialog from "./MobileDialog.astro";
import DesktopDialog from "./DesktopDialog.astro";
import { ExtractPrefixed } from "@xrayman/shared/astro/props/props";
import type { ButtonDialogProps } from "./types";

type Props = ButtonDialogProps;

const { ...props } = Astro.props;
const { ...pageProps } = ExtractPrefixed(props, "page");
---

<button-dialog data-breakpoint="768">
  <Button data-dialog-button {...props}>
    <slot name="button" />
  </Button>

  <MobileDialog {...pageProps} dlg:data-mobile-dialog>
    <slot name="page" slot="page" />
  </MobileDialog>

  <DesktopDialog {...pageProps} dlg:data-desktop-dialog>
    <slot name="page" slot="page" />
  </DesktopDialog>
</button-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";

  class ButtonDialog extends CustomElement {
    connectedCallback() {
      const btn = pt<HTMLButtonElement>(this, "dialog-button");

      btn.onclick = async () => {
        const breakpoint = Number(this.dataset.breakpoint ?? 768);
        const isDesktop = window.matchMedia(`(min-width: ${breakpoint}px)`).matches;

        const variant = isDesktop ? "desktop" : "mobile";
        const dlg = pt<HTMLDialogElement>(this, `${variant}-dialog`);
        dlg.showModal();
      };
    }
  }

  customElements.define("button-dialog", ButtonDialog);
</script>

<style>
  button-dialog {
    display: contents;
  }
</style>
