---
import Button from "@xrayman/shared/astro/primitives/Button.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof Button>;

const { ...props } = Astro.props;
---

<btn-dialog>
  <Button data-dialog-button {...props}>
    <slot name="button" />
  </Button>

  <dialog class="app-dialog" data-dialog>
    <div class="app-dialog-page h-center" data-dialog-page>
      <slot name="page" />
    </div>
  </dialog>
</btn-dialog>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";
  import type { Resettable } from "./ButtonDialog";

  class BtnDialog extends CustomElement {
    private button!: HTMLButtonElement;
    private dialog!: HTMLDialogElement;
    private page!: HTMLElement;

    connectedCallback() {
      this.button = pt<HTMLButtonElement>(this, "dialog-button");
      this.dialog = pt<HTMLDialogElement>(this, "dialog");
      this.page = pt<HTMLElement>(this, "dialog-page");

      this.button.onclick = async () => {
        this.dialog.showModal();
      };

      this.dialog.addEventListener("close", () => {
        this.reset();
      });

      const close = () => {
        this.dialog.close();
        this.reset();
      };

      this.page.onmousedown = (e) => {
        if (e.target === this.page) {
          close();
        }
      };
    }

    private reset() {
      Array.from(this.page.children).forEach((el) => {
        (el as Partial<Resettable>).reset?.();
      });
    }
  }

  customElements.define("btn-dialog", BtnDialog);
</script>

<style>
  btn-dialog {
    display: contents;
  }

  .app-dialog {
    background: rgba(255, 255, 255, 0.5);
    border: none;
    padding: 0;
    margin: 0;

    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    overflow: hidden;
  }

  .app-dialog::backdrop {
    background: transparent;
  }

  .app-dialog-page {
    position: absolute;
    inset: 0;

    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;

    box-sizing: border-box;
  }
</style>
