---
import Info from "@xrayman/shared/astro/primitives/Info.astro";
import I18NText from "@xrayman/shared/astro/primitives/I18nText.astro";
import Tag from "@xrayman/shared/astro/primitives/Tag.astro";
import Input from "./Input.astro";
import InputTags from "./InputTags.astro";
import Surface from "./Surface.astro";

type SafeInputAttributes = Omit<astroHTML.JSX.InputHTMLAttributes, "slot" | "style">;

interface FieldConfig {
  name: string;
  i18n: string;
  placeholders?: boolean;
  props?: SafeInputAttributes;
}

interface Props {
  id: string;
  fields: FieldConfig[];
  [key: string]: any;
}

const { id, fields, ...rest } = Astro.props;
---

<rwmap-element {...rest}>
  <form data-part="form" id={id}>
    {
      fields.map((field: FieldConfig) => (
          <Info>
            <I18NText data-i18n={field.i18n} />
          </Info>
          <div class="input-container mb-2" data-part="input-container">
            <Input name={field.name} data-part="input" {...field.props} />

            { field.placeholders && 
              <div class="tags-container" data-part="tags-container" hidden >
                <Surface
                  depth="var(--input-depth)"
                  color="var(--input-color)"
                >
                  <InputTags data-part="tags" />
                </Surface>
              </div>
            }
          </div>
      ))
    }
  </form>
</rwmap-element>

<style>
  .input-container {
    position: relative;
  }
  .tags-container {
    position: absolute;
    z-index: 1;
    top: 100%;
    width: 100%;

    margin-top: calc(-1 * var(--input-depth));
  }
</style>

<script>
  import { prop, CustomElement } from "../../runtime/dom/custom-element";
import { ptEl } from "../../runtime/dom/parted-element";
  import type { InputTagsElement } from "../types/InputTags";
  import { RWMapElement, RWMapData, InputType } from "../types/RWMap";

  class RWMap extends CustomElement implements RWMapElement {
    @prop accessor value: RWMapData = {};
    @prop accessor placeholders: string[] = [];

    private formEl!: HTMLFormElement;
    private tagsEls: InputTagsElement[] = [];

    connectedCallback() { 
      super.connectedCallback();
      this.formEl = this.pt<HTMLFormElement>("form");

      const containers = this.formEl.querySelectorAll<HTMLElement>('[data-part="input-container"]');

      containers.forEach((container) => {
        const inputEl = container.querySelector<HTMLInputElement>('[data-part="input"]');
        const tagsContainerEl = container.querySelector<HTMLElement>('[data-part="tags-container"]');
        if (!inputEl || !tagsContainerEl) return;

        inputEl.addEventListener("focus", () => {
          tagsContainerEl.removeAttribute("hidden");
        });
        inputEl.addEventListener("blur", () => {
          tagsContainerEl.setAttribute("hidden", "");
        });
        inputEl.addEventListener("keydown", (event: KeyboardEvent) => {
          if (event.key === "Enter") {
            event.preventDefault();
          }
        });
        tagsContainerEl.addEventListener("mousedown", (event) => {
          event.preventDefault();
        });

        const tagsEl = ptEl<InputTagsElement>(tagsContainerEl, "tags");
        tagsEl.input = inputEl;
        this.tagsEls.push(tagsEl);
      });
    }

    disconnectedCallback() {}

    protected render() {
      for (const tagsEl of this.tagsEls) {
        tagsEl.tags = this.placeholders
      }

      for (const [fieldName, value] of Object.entries(this.value)) {
        const element = this.formEl.elements.namedItem(fieldName);
        if (element instanceof HTMLInputElement) {
          element.value = value !== undefined && value !== null ? value.toString() : "";
          element.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }

    getValue(): RWMapData {
      const formData = new FormData(this.formEl);
      const rawEntries = Object.fromEntries(formData.entries());
      const result: RWMapData = {};

      for (const [key, value] of Object.entries(rawEntries)) {
        result[key] = value.toString().trim();
      }

      return result;
    }
  }

  customElements.define("rwmap-element", RWMap);
</script>