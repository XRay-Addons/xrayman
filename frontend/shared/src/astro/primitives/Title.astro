---
import Surface from "./Surface.astro";

interface Props {
  class?: string;
  "in:class"?: string;
}

const { class: extraClass = "", "in:class": inClass = "" } = Astro.props;
---

<div class="d-flex justify-content-center">
  <Surface
    class={extraClass}
    in:class=`text-center text text-lg crt flicker p-2 noselect ${inClass}`
    depth="var(--title-depth)"
    color="var(--title-color)"
  >
    <slot />
  </Surface>
</div>
