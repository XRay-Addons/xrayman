---
interface Props {
  src: string;
  class?: string;
}

const { src, class: extraClass = "", ...rest } = Astro.props;
---

<lazy-img>
  <img class={extraClass} data-image data-src={src} {...rest} />
</lazy-img>

<style>
  lazy-img {
    display: contents;
  }
</style>

<script>
  import { CustomElement } from "@xrayman/shared/runtime/dom/custom-element";
  import { pt } from "@xrayman/shared/runtime/dom/pts";

  class LazyImg extends CustomElement {
    obs?: IntersectionObserver;

    connectedCallback() {
      super.connectedCallback();

      const imageEl = pt<HTMLImageElement>(this, "image");
      this.obs = new IntersectionObserver(([entry], obs) => {
        if (entry.isIntersecting) {
          imageEl.src = imageEl.dataset.src!;
          obs.disconnect();
        }
      });

      this.obs.observe(imageEl);
    }

    disconnectedCallback() {
      this.obs?.disconnect();
      this.obs = undefined;
    }
  }

  customElements.define("lazy-img", LazyImg);
</script>
