{
  "name": "frontend",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "pages/*"
  ],
  "scripts": {
    "gen:admin": "pnpm -F admpage run api:generate && pnpm -F admpage run schema:generate",
    "gen:user": "pnpm -F userpage run api:generate && pnpm -F userpage run schema:generate",
    "gen": "pnpm -r run api:generate",
    "build:admin": "pnpm -F admpage run build",
    "build:user": "pnpm -F userpage run build",
    "build": "pnpm run build:user && pnpm run build:admin",
    "check": "astro check && eslint ."
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.12",
    "@typescript-eslint/parser": "^8.64.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "sass-embedded": "^1.99.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.59.4"
  }
}
