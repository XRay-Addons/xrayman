{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "gen:admin": "pnpm --filter admpage run api:generate && pnpm --filter admpage run schema:generate",
    "gen:user": "pnpm --filter userpage run api:generate && pnpm --filter userpage run schema:generate",
    "gen": "pnpm -r run api:generate",
    "build:admin": "pnpm --filter admpage run build",
    "build:user": "pnpm --filter userpage run build",
    "build": "pnpm run build:user && pnpm run build:admin",
    "check": "pnpm -r run check"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.12",
    "@typescript-eslint/parser": "^8.64.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "sass-embedded": "^1.99.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
