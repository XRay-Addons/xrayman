{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminPageConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["ApiPrefix", "AdminPrefix", "UserPrefix", "SettingsTags"],

  "properties": {
    "ApiPrefix": {
      "type": "string",
      "description": "prefix for api requests"
    },

    "AdminPrefix": {
      "type": "string",
      "description": "prefix for admin page spa"
    },

    "UserPrefix": {
      "type": "string",
      "description": "prefix for user page spa"
    },

    "SettingsTags": {
      "type": "array",
      "description": "List of allowed settings placeholders",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
