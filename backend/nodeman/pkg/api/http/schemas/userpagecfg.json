{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserPageConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["ApiPrefix", "UserPrefix", "SupportLink", "AppLinks"],

  "properties": {
    "ApiPrefix": {
      "type": "string",
      "description": "prefix for api requests"
    },

    "UserPrefix": {
      "type": "string",
      "description": "prefix for user page spa"
    },

    "SupportLink": {
      "type": "string",
      "description": "prefix for user page spa"
    },

    "AppLinks": {
      "type": "array",
      "description": "application links",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Name", "Platforms", "URL"],
        "properties": {
          "Name": {
            "type": "string"
          },

          "Platforms": {
            "type": "string"
          },

          "URL": {
            "type": "string"
          }
        }
      }
    }
  }
}
